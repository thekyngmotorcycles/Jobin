{
  "expo": {
    "name": "Jobin",
    "slug": "jobin",
    "version": "0.2.0",
    "scheme": "jobin",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thekyngmotorcycles.jobin"
    },
    "android": {
      "package": "com.thekyngmotorcycles.jobin",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Jobin",
      "lang": "es"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Jobin seleccionar los videos de tu trabajo.",
          "cameraPermission": "Permite a Jobin grabar tus videos profesionales.",
          "microphonePermission": "Permite a Jobin grabar audio en tus videos."
        }
      ],
      "expo-video"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a6befb1a-dc03-45a8-a18c-294643e99434"
      }
    },
    "owner": "proyect-dating",
    "updates": {
      "url": "https://u.expo.dev/a6befb1a-dc03-45a8-a18c-294643e99434"
    }
  }
}
