{
  "name": "jobin",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export": "expo export --platform all",
    "export:web": "expo export --platform web",
    "check": "npm run lint && npm run typecheck && npm test && npm run export",
    "expo:configure": "node scripts/configure-expo.mjs",
    "update:development": "npx eas-cli@27.1.0 update --branch development --environment preview --platform all --non-interactive",
    "build:preview": "npx eas-cli@27.1.0 build --profile preview --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "expo-video": "~3.0.16",
    "expo-image-picker": "~17.0.11",
    "expo-document-picker": "~14.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "react-native-url-polyfill": "^2.0.0",
    "@react-navigation/native": "^7.1.8",
    "expo-updates": "~29.0.20",
    "expo-dev-client": "~6.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0"
  }
}
